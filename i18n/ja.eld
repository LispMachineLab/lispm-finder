(:name "日本語"
 :messages
 (("Go to the enclosing folder (Delete)" . "内包しているフォルダへ移動（Delete）")
  ("%d item, %s available" . "%d 項目、%s 利用可能")
  ("%d item" . "%d 項目")
  ("Nothing can be made or renamed in “%s”" . "“%s”内では新規作成や名称変更はできません")
  ("Name of the new folder: " . "新規フォルダの名前：")
  ("untitled folder" . "名称未設定フォルダ")
  ("There is already an item called “%s” here" . "ここにはすでに“%s”という項目があります")
  ("“%s” was moved to the Trash" . "“%s”をゴミ箱に入れました")
  ("Select an item first" . "先に項目を選択してください")
  ("“%s” cannot have an alias on the desktop" . "“%s”のエイリアスはデスクトップに作成できません")
  ("Move to Trash" . "ゴミ箱に入れる")
  ("“%s” could not be thrown away." . "“%s”をゴミ箱に入れられませんでした。")
  ("OK" . "OK")
  ("“%s” cannot be thrown away" . "“%s”はゴミ箱に入れられません")
  ("Rename to: " . "新しい名前：")
  ("Open" . "開く")
  ("New Folder…" . "新規フォルダ…")
  ("Rename…" . "名前を変更…")
  ("Make Alias on Desktop" . "デスクトップにエイリアスを作成")
  ("Copy Path" . "パスをコピー")
  ("Folder: " . "フォルダ：")
  ("Home" . "ホーム")
  ("Desktop" . "デスクトップ")
  ("Documents" . "書類")
  ("Downloads" . "ダウンロード")
  ("Pictures" . "ピクチャ")
  ("Go to enclosing folder or standard place (/)" . "親フォルダまたは標準の場所へ移動（/）")
  ("Create a new folder (M-N)" . "新規フォルダを作成（M-N）")
  ("Cancel" . "キャンセル")
  ("Choose" . "選択")
  ("Choose a Folder" . "フォルダを選択")
  ("Choose a File" . "ファイルを選択")))
