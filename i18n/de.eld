(:name "Deutsch"
 :messages
 (("Go to the enclosing folder (Delete)" . "Zum übergeordneten Ordner wechseln (Rückschritttaste)")
  ("%d item, %s available" . ("%d Objekt, %s verfügbar" "%d Objekte, %s verfügbar"))
  ("%d item" . ("%d Objekt" "%d Objekte"))
  ("Nothing can be made or renamed in “%s”" . "In „%s“ kann nichts angelegt oder umbenannt werden")
  ("Name of the new folder: " . "Name des neuen Ordners: ")
  ("untitled folder" . "Neuer Ordner")
  ("There is already an item called “%s” here" . "Hier existiert bereits ein Objekt namens „%s“")
  ("“%s” was moved to the Trash" . "„%s“ wurde in den Papierkorb gelegt")
  ("Select an item first" . "Wählen Sie zuerst ein Objekt aus")
  ("“%s” cannot have an alias on the desktop" . "Für „%s“ kann kein Alias auf dem Schreibtisch angelegt werden")
  ("Move to Trash" . "In den Papierkorb legen")
  ("“%s” could not be thrown away." . "„%s“ konnte nicht in den Papierkorb gelegt werden.")
  ("OK" . "OK")
  ("“%s” cannot be thrown away" . "„%s“ kann nicht in den Papierkorb gelegt werden")
  ("Rename to: " . "Umbenennen in: ")
  ("Open" . "Öffnen")
  ("New Folder…" . "Neuer Ordner…")
  ("Rename…" . "Umbenennen…")
  ("Make Alias on Desktop" . "Alias auf dem Schreibtisch erzeugen")
  ("Copy Path" . "Pfad kopieren")
  ("Folder: " . "Ordner: ")
  ("Home" . "Privat")
  ("Desktop" . "Schreibtisch")
  ("Documents" . "Dokumente")
  ("Downloads" . "Downloads")
  ("Pictures" . "Bilder")
  ("Go to enclosing folder or standard place (/)" . "Zum übergeordneten Ordner oder Standardort wechseln (/)")
  ("Create a new folder (M-N)" . "Neuen Ordner anlegen (M-N)")
  ("Cancel" . "Abbrechen")
  ("Choose" . "Auswählen")
  ("Choose a Folder" . "Ordner auswählen")
  ("Choose a File" . "Datei auswählen")))
